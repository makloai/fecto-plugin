# Keys for the sources this dashboard reads. This file stays on this computer:
# it is gitignored and only fetch.mjs reads it. Fill in only the sources you use.

# Google Search Console + GA4: path to a service account key file (relative to this folder),
# or leave empty to use your own `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# PostHog: a personal API key (phx_...) with query:read. Not the phc_ key in the site's code.
POSTHOG_PERSONAL_API_KEY=

# Plausible: Settings → API keys → Stats API.
PLAUSIBLE_API_KEY=

# Stripe: a restricted key (rk_live_...) with Read on Balance, Customers, Subscriptions.
STRIPE_API_KEY=
